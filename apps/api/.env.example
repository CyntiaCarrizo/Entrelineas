# Copiar como .env y completar. Nunca subir .env al repositorio.

# Servidor
PORT=4000
NODE_ENV=development

# Base de datos (MySQL). Formato: mysql://USUARIO:CONTRASEÑA@SERVIDOR:PUERTO/BASE
DATABASE_URL="mysql://entrelineas:contraseña@localhost:3306/entrelineas?allowPublicKeyRetrieval=true"
# Base temporal que usa "prisma migrate dev" para comparar estados
SHADOW_DATABASE_URL="mysql://entrelineas:contraseña@localhost:3306/entrelineas_shadow?allowPublicKeyRetrieval=true"
# Base que usan los tests (se vacía en cada corrida)
TEST_DATABASE_URL="mysql://entrelineas:contraseña@localhost:3306/entrelineas_test?allowPublicKeyRetrieval=true"

# Se completan en las fases siguientes
JWT_SECRET=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
PUBLIC_URL=http://localhost:3000
CLOUDINARY_URL=
GOOGLE_BOOKS_KEY=
TURNSTILE_SECRET=
WHATSAPP_NUMERO=
TRANSFERENCIA_ALIAS=
TRANSFERENCIA_CBU=
